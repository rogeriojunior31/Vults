{
  "name": "vults",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite ui",
    "build": "tsc -p ui && vite build ui",
    "tauri": "tauri",
    "predev": "cargo build --release -p vults-hook",
    "pretauri": "cargo build --release -p vults-hook",
    "bundle:linux": "cargo build --release -p vults-hook && tauri build --config app/tauri.bundle.linux.json",
    "bundle:windows": "cargo build --release -p vults-hook && tauri build --config app/tauri.bundle.windows.json",
    "test:visual": "scripts/visual.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^8"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
